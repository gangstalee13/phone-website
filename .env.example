# Copy this file to .env and fill in real values. Never commit .env.

# Paynow merchant integration details.
# Get these from https://www.paynow.co.zw/home/businesshome after registering
# as a merchant and enabling EcoCash on your integration.
PAYNOW_INTEGRATION_ID=your-integration-id
PAYNOW_INTEGRATION_KEY=your-integration-key

# Public URL of this server, used to build the Paynow result (webhook) URL.
# During local development you can use a tool like ngrok and put that URL here,
# since Paynow needs to reach this server from the internet, not localhost.
PUBLIC_BASE_URL=https://your-domain.example.com

# Port the Node server listens on.
PORT=4000

# Basic-auth credentials protecting the /admin dashboard and /api/admin/* routes.
# Change these to something strong before deploying.
ADMIN_USER=admin
ADMIN_PASS=change-me

# EcoCash number displayed to customers as a manual fallback (unchanged from before).
ECOCASH_DISPLAY_NUMBER=0785233384
